# Template for the env file this library reads. Copy it to /web/.env on the
# host and fill in real values. It is the one place the credentials exist, so
# it is gitignored here, excluded from every deploy, and denied by apache
# (see the demo repo's apache/signcollect-web.conf).
#
#   sudo install -o <deploy user> -g www-data -m 640 .env.example /web/.env
#
# Mode 640 is deliberate: www-data must read it, nobody else should.
DB_HOST=localhost
DB_USER=replace_me
DB_PASS=replace_me
DB_NAME=admin_gebarenoverleg
